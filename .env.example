# Required for research-grounded script generation.
GEMINI_API_KEY=
# First model is tried before the next; comma-separated.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest
# Optional Google Programmable Search Engine; without both values DuckDuckGo HTML search is used.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional authenticated image provider. Pollinations is attempted first by default.
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_PROVIDER_ORDER=pollinations,huggingface,local
ALLOW_LOCAL_FALLBACK=true

# Optional sound design; must be a local, properly licensed audio file.
MUSIC_PATH=
VOICE=hi-IN-SwaraNeural
SPEECH_RATE=+0%
SPEECH_PITCH=+0Hz
LANGUAGE=Hindi
DURATION_MINUTES=8
VISUAL_STYLE=Cinematic Documentary
OUTPUT_DIR=output

# Optional runtime tuning.
MAX_RETRIES=3
REQUEST_TIMEOUT=45
FFMPEG=ffmpeg
FFPROBE=ffprobe
# A Unicode font with Devanagari glyphs (the workflow installs Noto Sans Devanagari).
FONT_PATH=
